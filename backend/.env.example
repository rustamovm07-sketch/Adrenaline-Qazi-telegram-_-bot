# PostgreSQL connection. Keep the real value only in backend/.env.
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/adrenalin_qazi

# Create a bot with @BotFather and keep this secret out of source control.
BOT_TOKEN=

# Numeric Telegram user ID of the single project owner/admin.
ADMIN_TELEGRAM_ID=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
MINI_APP_SESSION_TTL_SECONDS=43200

# Hamyon API (set prepare_url and complete_url in the Hamyon shop settings)
HAMYON_API_BASE_URL=https://hamyon-api.uz
HAMYON_SHOP_ID=
HAMYON_SHOP_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HAMYON_CARD_ENCRYPTION_KEY=

# Public HTTPS URLs required by Telegram Mini Apps.
MINI_APP_URL=https://your-domain.example/shop
ADMIN_PANEL_URL=https://your-domain.example/admin

# Comma-separated exact web origins. Add deployed customer/admin origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Required in production for limits shared across API workers.
APP_ENV=development
REDIS_URL=

# Hours an unpaid order keeps its stock reserved (1-72; default 12).
ORDER_RESERVATION_HOURS=12
